{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* 9-10 * * 6"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 10,
  "labels": ["area:deps"],
  "branchPrefix": "renovate-",
  "branchNameStrict": true,
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "GitHub Actions, grouped like Dependabot's github-actions group",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "build",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Base images in the Dockerfile",
      "matchManagers": ["dockerfile"],
      "groupName": "docker-images",
      "semanticCommitType": "build",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Decompiler releases pinned as ARGs in the Dockerfile",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "build",
      "semanticCommitScope": "decompilers"
    },
    {
      "description": "Longer cooldown for major releases",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Shorter cooldown for patch releases",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "2 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG CFR_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "leibnitz27/cfr",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG VINEFLOWER_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "Vineflower/vineflower",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG JADX_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "skylot/jadx",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG DEX2JAR_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "ThexXTURBOXx/dex2jar",
      "datasourceTemplate": "github-releases"
    }
  ]
}
